# Copia este archivo como ".env" y rellena solo las claves que quieras usar.
# Todas son opcionales: sin claves la herramienta funciona con el rastreo propio.

# Puerto y host del servidor local
PORT=3000
HOST=127.0.0.1

# Google PageSpeed Insights (gratis) - Core Web Vitals
GOOGLE_API_KEY=

# OpenPageRank (gratis) - autoridad de dominio
OPR_API_KEY=

# DataForSEO (de pago) - backlinks, keywords posicionadas, volúmenes, competidores
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Anthropic (de pago) - visibilidad de tu marca en respuestas de IA
ANTHROPIC_API_KEY=
